      ],
      "id": "916badab-094f-4ae1-9870-cf1a083e177a",
      "name": "Get top story ID",
      "alwaysOutputData": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\nlet ids = [];\n\n// Many output items = one ID per item (common in n8n)\nif (allItems.length > 1) {\n  ids = allItems\n    .map((item) => item.json)\n    .map((j) => (typeof j === 'number' ? j : Number(j)))\n    .filter((n) => !Number.isNaN(n));\n} else {\n  let raw = allItems[0]?.json;\n\n  if (typeof raw === 'string') {\n    raw = JSON.parse(raw.trim());\n  }\n\n  if (Array.isArray(raw)) {\n    ids = raw.map(Number).filter((n) => !Number.isNaN(n));\n  } else if (raw && typeof raw === 'object') {\n    const vals = Object.values(raw);\n    if (vals.length && vals.every((v) => typeof v === 'number' || /^\\d+$/.test(String(v)))) {\n      ids = vals.map(Number);\n    }\n  }\n}\n\nif (!ids.length) {\n  throw new Error('Still no IDs. Item count=' + allItems.length);\n}\n\nconst stories = [];\n\nfor (const id of ids.slice(0, 30)) {\n  const item = await this.helpers.httpRequest({\n    method: 'GET',\n    url: `https://hacker-news.firebaseio.com/v0/item/${id}.json`,\n    json: true,\n  });\n  if (item?.type === 'story' && item.title) {\n    stories.push(item);\n  }\n}\n\nstories.sort((a, b) => (b.score ?? 0) - (a.score ?? 0));\nconst topFive = stories.slice(0, 5);\n\nreturn [\n  {\n    json: {\n      topFive,\n      topStory: topFive[0],\n      fetchedAt: new Date().toISOString(),\n    },\n  },\n];"
      },
