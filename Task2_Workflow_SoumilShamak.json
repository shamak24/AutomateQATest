      "id": "549e9bca-e6df-451f-956f-eb5854d0e48a",
      "name": "If"
    },
    {
      "parameters": {
        "jsCode": "const rank = $('Fetch & Rank top 5').item.json;\nconst user = $input.first().json; // HN user object from Enrich\n\nconst lines = rank.topFive.map((s, i) =>\n  `${i + 1}. [${s.score}] ${s.title}\\n   ${s.url || 'https://news.ycombinator.com/item?id=' + s.id}`\n);\n\nconst top = rank.topStory;\nconst karma = user.karma ?? 'n/a';\nconst comments = top.descendants ?? (top.kids || []).length;\n\nconst content = [\n  '🔥 **HN Brief (hot top story)**',\n  `Fetched: ${rank.fetchedAt}`,\n  '',\n  `**#1:** ${top.title} (score ${top.score})`,\n  `By **${top.by}** · karma **${karma}** · ~**${comments}** comments`,\n  top.url || `https://news.ycombinator.com/item?id=${top.id}`,\n  '',\n  '**Top 5:**',\n  ...lines,\n].join('\\n');\n\nreturn [{ json: { content } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        -320
      ],
      "id": "0a283ebc-b089-4a68-8cd0-6124caa0ae8f",
      "name": "Build digest (hot)"
    },
    {
      "parameters": {
        "jsCode": "const rank = $('Fetch & Rank top 5').item.json;\nconst user = $input.first().json; // HN user object from Enrich\n\nconst lines = rank.topFive.map((s, i) =>\n  `${i + 1}. [${s.score}] ${s.title}\\n   ${s.url || 'https://news.ycombinator.com/item?id=' + s.id}`\n);\n\nconst top = rank.topStory;\nconst karma = user.karma ?? 'n/a';\nconst comments = top.descendants ?? (top.kids || []).length;\n\nconst content = [\n  '📰**HN Brief **',\n  `Fetched: ${rank.fetchedAt}`,\n  '',\n  `**#1:** ${top.title} (score ${top.score})`,\n  `By **${top.by}** · karma **${karma}** · ~**${comments}** comments`,\n  top.url || `https://news.ycombinator.com/item?id=${top.id}`,\n  '',\n  '**Top 5:**',\n  ...lines,\n].join('\\n');\n\nreturn [{ json: { content } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
